{
  "doctype": "DocType",
  "name": "Design Milestone Step Template",
  "module": "Marina Design Management",
  "custom": 0,
  "istable": 1,
  "editable_grid": 1,
  "track_changes": 0,
  "fields": [
    {
      "fieldname": "step",
      "label": "Step",
      "fieldtype": "Select",
      "options": "Ready to Start\nIn Progress\nReady\nRework\nCompleted",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "enabled",
      "label": "Enabled",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1,
      "columns": 1
    },
    {
      "fieldname": "transition_mode",
      "label": "Transition",
      "fieldtype": "Select",
      "options": "Auto\nManual",
      "default": "Manual",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 1
    },
    {
      "fieldname": "responsible_module_role",
      "label": "Who Can Select (Module Role)",
      "fieldtype": "Link",
      "options": "Design Module Role",
      "in_list_view": 1,
      "columns": 2,
      "description": "Mandatory for manual transitions; Auto steps are triggered by the system."
    },
    {
      "fieldname": "custody_role",
      "label": "Custody Role",
      "fieldtype": "Link",
      "options": "Design Module Role",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "lead_time_days",
      "label": "Lead Time To Complete (Days)",
      "fieldtype": "Int",
      "default": 0,
      "in_list_view": 1,
      "columns": 1
    },
    {
      "fieldname": "requires_evidence",
      "label": "Require Evidence",
      "fieldtype": "Check",
      "default": 0,
      "in_list_view": 1,
      "columns": 1
    },
    {
      "fieldname": "evidence_type",
      "label": "Evidence Type",
      "fieldtype": "Link",
      "options": "Design Document Type",
      "in_list_view": 1,
      "columns": 2,
      "depends_on": "eval:doc.requires_evidence"
    }
  ],
  "field_order": [
    "step",
    "enabled",
    "transition_mode",
    "responsible_module_role",
    "custody_role",
    "lead_time_days",
    "requires_evidence",
    "evidence_type"
  ],
  "permissions": []
}
