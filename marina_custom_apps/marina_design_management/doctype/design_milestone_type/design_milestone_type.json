{
  "doctype": "DocType",
  "name": "Design Milestone Type",
  "module": "Marina Design Management",
  "custom": 0,
  "istable": 0,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "milestone_type",
      "label": "Milestone",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "is_active",
      "label": "Enabled",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "sequence",
      "label": "Display Sequence",
      "fieldtype": "Int",
      "default": 10,
      "in_list_view": 1,
