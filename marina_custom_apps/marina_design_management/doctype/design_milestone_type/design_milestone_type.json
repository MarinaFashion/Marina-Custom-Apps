      "options": "Ready to Start\nIn Progress\nReady\nRework\nCompleted",
      "default": "Completed",
      "depends_on": "eval:!doc.start_with_design_creation"
    },
    {
      "fieldname": "workflow_steps",
      "label": "Milestone Workflow Steps",
      "fieldtype": "Table",
      "options": "Design Milestone Step Template",
      "reqd": 1
    }
  ],
  "field_order": [
    "milestone_type",
    "is_active",
    "sequence",
    "start_with_design_creation",
    "depends_on_type",
    "r22_trigger_status",
    "workflow_steps"
