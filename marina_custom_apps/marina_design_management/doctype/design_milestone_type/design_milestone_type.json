    },
    {
      "fieldname": "start_with_design_creation",
      "label": "Start with Design Creation",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "depends_on_type",
      "label": "Start After Milestone",
      "fieldtype": "Link",
      "options": "Design Milestone Type",
      "depends_on": "eval:!doc.start_with_design_creation"
    },
    {
      "fieldname": "r22_trigger_status",
      "label": "Start after Milestone Step",
