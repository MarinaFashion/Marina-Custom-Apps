    "total_purchase_value",
    "savings_value",
    "savings_percent",
    "col_totals",
    "weighted_unit_price",
    "estimated_component_value",
    "estimated_sar_value",
    "sec_approval",
    "prepared_by",
    "submitted_by",
    "submitted_on",
