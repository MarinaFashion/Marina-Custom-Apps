    "design_code",
    "revision_no",
    "status",
    "costing_method",
    "quotation_date",
    "quotation_reference",
    "quotation_attachment",
    "col_identity",
    "design_image",
    "mood_board",
    "factory",
    "merchandiser",
    "currency",
    "incoterm",
    "exchange_rate_sar",
