                            "create":  1,
                            "submit":  1,
                            "cancel":  1,
                            "delete":  1,
                            "print":  1,
                            "email":  1,
                            "export":  1,
                            "report":  1,
                            "share":  1
                        },
                        {
                            "role":  "Stock Manager",
                            "permlevel":  1,
                            "read":  1
                        },
                        {
                            "role":  "System Manager",
                            "permlevel":  1,
                            "read":  1
                        }
                    ]
}
