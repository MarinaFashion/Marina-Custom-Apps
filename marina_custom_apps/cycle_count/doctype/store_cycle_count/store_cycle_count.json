                       "fieldtype":  "Int",
                       "read_only":  1
                   },
                   {
                       "fieldname":  "counted_lines",
                       "label":  "Counted Lines",
                       "fieldtype":  "Int",
                       "read_only":  1
                   },
                   {
                       "fieldname":  "variance_lines",
                       "label":  "Variance Lines",
                       "fieldtype":  "Int",
