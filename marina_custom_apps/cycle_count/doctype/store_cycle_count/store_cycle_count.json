    "is_submittable":  1,
    "field_order":  [
                        "naming_series",
                        "cycle_count_plan",
                        "company",
                        "warehouse",
                        "assigned_to",
                        "status",
                        "schedule_section",
                        "count_date",
                        "count_started_on",
                        "count_completed_on",
                        "counting_section",
                        "entry_mode",
