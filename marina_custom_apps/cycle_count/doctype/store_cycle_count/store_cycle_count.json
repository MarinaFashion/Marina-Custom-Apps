                       "options":  "SCC-.YYYY.-.#####",
                       "default":  "SCC-.YYYY.-.#####",
                       "reqd":  1
                   },
                   {
                       "fieldname":  "cycle_count_plan",
                       "label":  "Cycle Count Plan",
                       "fieldtype":  "Link",
                       "options":  "Cycle Count Plan",
                       "reqd":  1,
                       "read_only":  1
                   },
                   {
                       "fieldname":  "company",
                       "label":  "Company",
                       "fieldtype":  "Link",
                       "options":  "Company",
                       "reqd":  1,
                       "read_only":  1
                   },
                   {
                       "fieldname":  "warehouse",
