                    ],
    "fields":  [
                   {
                       "description":  "Accounting is independent from reconciliation. Only Matching or Manually Cleared bank transactions are eligible for posting. Cost Center comes from POS Profile \u003e Cost Center.",
                       "fieldname":  "accounting_section",
                       "fieldtype":  "Section Break",
                       "label":  "Accounting Posting"
                   },
                   {
                       "fieldname":  "company",
                       "fieldtype":  "Link",
                       "label":  "Company",
                       "options":  "Company",
                       "reqd":  1
                   },
                   {
                       "description":  "Debit account for POS bank commission. The Journal Entry expense line uses the Cost Center from the transaction POS Profile.",
                       "fieldname":  "commission_expense_account",
                       "fieldtype":  "Link",
                       "label":  "Commission Expense Account",
                       "options":  "Account"
                   },
                   {
                       "description":  "Debit account for VAT on POS bank commission.",
                       "fieldname":  "vat_input_account",
                       "fieldtype":  "Link",
                       "label":  "VAT Input Account",
                       "options":  "Account"
                   },
                   {
                       "fieldname":  "accounting_column_break",
                       "fieldtype":  "Column Break"
                   },
                   {
                       "description":  "Credit GL account for commission and VAT charged by the bank. Commission and VAT are created as separate credit lines.",
                       "fieldname":  "default_offset_account",
                       "fieldtype":  "Link",
                       "label":  "Bank Account",
                       "options":  "Account"
                   },
                   {
                       "default":  "Manual",
                       "description":  "Stored now for the next accounting-posting phase. v0.52.1 does not create GL entries.",
                       "fieldname":  "posting_frequency",
                       "fieldtype":  "Select",
                       "label":  "Posting Frequency",
                       "options":  "Manual\nPer Settlement\nDaily",
                       "hidden":  1
                   },
                   {
                       "fieldname":  "posting_control_section",
                       "fieldtype":  "Section Break",
                       "label":  "Posting Controls"
                   },
                   {
                       "default":  "0",
                       "description":  "Reserved for the later accounting-posting release. No Journal Entries are created by v0.52.1.",
                       "fieldname":  "auto_create_accounting_entries",
                       "fieldtype":  "Check",
                       "label":  "Auto Create Accounting Entries",
                       "hidden":  1
                   },
                   {
                       "default":  "0",
                       "fieldname":  "allow_posting_before_finance_audit",
                       "fieldtype":  "Check",
                       "label":  "Allow Posting Before Finance Audit",
                       "hidden":  1
                   },
                   {
                       "fieldname":  "finance_review_section",
                       "fieldtype":  "Section Break",
                       "label":  "Finance Review Controls"
                   },
                   {
                       "default":  "1",
                       "fieldname":  "allow_bulk_finance_review",
                       "fieldtype":  "Check",
                       "label":  "Allow Bulk Finance Review"
                   },
                   {
                       "default":  "0",
                       "description":  "Master switch for manual Journal Entry posting of confirmed POS bank commission and VAT.",
                       "fieldname":  "enable_accounting_posting",
                       "fieldtype":  "Check",
                       "label":  "Enable POS Accounting Posting"
                   },
                   {
                       "default":  "1",
                       "description":  "When enabled, confirmed transactions from multiple POS Profiles in the same settlement/date can be posted in one Journal Entry. Commission remains split by POS Profile Cost Center.",
                       "fieldname":  "consolidate_pos_profiles_in_one_journal_entry",
                       "fieldtype":  "Check",
                       "label":  "Consolidate Multiple POS Profiles in One Journal Entry"
                   }
               ],
